# Copy to .env. Everything is optional: with no changes the app runs on embedded PostgreSQL.

# --- LLM ---
# Without a key, tasks created with no skills stay "pending" and can't be assigned.
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash-lite
# SKILL_RETRY_INTERVAL_MS=60000

# --- Database: embedded (default) ---
# DB_MODE=embedded
# Used by local `npm run dev`. Docker keeps embedded data in a named volume instead.
# DB_EMBEDDED_DATA_DIR=.data/postgres
# DB_EMBEDDED_PORT=55432
# DB_EMBEDDED_USER=postgres
# DB_EMBEDDED_PASSWORD=postgres
# DB_EMBEDDED_NAME=task_assignment

# --- Database: external server ---
# Uncomment both lines, then run: docker compose --profile external up --build
# DB_MODE=external
# DATABASE_URL=postgres://postgres:postgres@postgres:5432/task_assignment
# To use your own server, point DATABASE_URL at it and leave out --profile external.

# Used only by the optional postgres service. Change the password outside local use,
# and keep DATABASE_URL in step with these.
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=postgres
# POSTGRES_DB=task_assignment

# --- API ---
# LOG_LEVEL=info
# Comma-separated. Empty means same-origin only, which is all the bundled frontend needs.
# CORS_ALLOWED_ORIGINS=
# RATE_LIMIT_WINDOW_MS=60000
# RATE_LIMIT_MAX=300

# --- Host ports ---
# BACKEND_PORT=3000
# FRONTEND_PORT=8080
